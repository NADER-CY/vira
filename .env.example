# VIRA local development environment. Copy to .env with `scripts/dev-setup.sh` (generates random values).
# .env is git-ignored. These are LOCAL DEVELOPMENT values only — staging/production secrets live in the
# deployment secret store and are never committed.

# PostgreSQL superuser (local container only)
VIRA_PG_SUPERUSER_PASSWORD=change-me
# Runtime database roles (doc 06 §1)
MIGRATOR_PASSWORD=change-me
APP_PUBLIC_PASSWORD=change-me
APP_ADMIN_PASSWORD=change-me
APP_WORKER_PASSWORD=change-me

# Admin realm: base64 of exactly 32 random bytes; encrypts TOTP secrets at rest
VIRA_ADMIN_TOTP_KEY=change-me

# Local object storage (MinIO)
MINIO_ROOT_USER=vira-dev
MINIO_ROOT_PASSWORD=change-me

# Public-realm JWT signing keys (ES256). dev-setup.sh writes them to .data/jwt/ (git-ignored).
VIRA_JWT_DIR=./.data/jwt

# Web apps (Vite)
VITE_API_BASE_URL=http://localhost:8080
VITE_ADMIN_API_BASE_URL=http://localhost:8081
